{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@tsconfig/bun/tsconfig.json",
  "include": ["./"],
  "compilerOptions": {
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noPropertyAccessFromIndexSignature": true,
    "outDir": "./build",
    "paths": {
      "@/*": ["./src/*"]
    },
    "plugins": [{ "name": "@effect/language-service" }],
    "rootDir": "."
  }
}
