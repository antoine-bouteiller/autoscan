{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  packageRules: [
    {
      description: 'Drizzle Group',
      groupName: 'drizzle',
      matchPackageNames: ['drizzle-orm', 'drizzle-kit'],
      versioning: 'docker',
    },
    {
      description: 'Vite+ Group',
      groupName: 'vite-plus',
      matchPackageNames: ['vite-plus', '@vitest/coverage-v8'],
    },
  ],
}
