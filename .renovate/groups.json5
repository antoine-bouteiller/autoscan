{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  packageRules: [
    {
      description: 'Drizzle Group',
      groupName: 'drizzle',
      matchPackageNames: ['drizzle-orm', 'drizzle-kit'],
      versioning: 'docker',
    },
    {
      description: 'Oxc Group',
      groupName: 'oxc',
      matchPackageNames: ['oxlint', 'oxfmt', 'oxlint-tsgolint', '@oxlint/plugins', '@effect/tsgo'],
    },
    {
      description: 'Effect Group',
      groupName: 'effect',
      matchPackageNames: ['effect', '@effect/**', '!@effect/tsgo'],
    },
    {
      description: 'Bun runtime, its types, and packageManager must move together',
      groupName: 'bun',
      matchDepNames: ['bun', '@types/bun'],
    },
  ],
}
