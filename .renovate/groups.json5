{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  packageRules: [
    {
      description: 'Drizzle Group',
      groupName: 'drizzle',
      matchPackageNames: ['drizzle-orm', 'drizzle-kit'],
      versioning: 'docker',
    },
    {
      description: 'Oxc Group',
      groupName: 'oxc',
      matchPackageNames: ['oxlint', 'oxfmt', 'oxlint-tsgolint'],
    },
  ],
}
