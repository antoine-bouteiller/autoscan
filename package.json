{
  "name": "autoscan",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "fmt": "oxfmt",
    "lint": "oxlint --fix --fix-suggestions --max-warnings=0",
    "dev": "bun --watch src/index.ts",
    "check": "oxfmt --check && oxlint --max-warnings=0",
    "knip": "knip",
    "knip:production": "knip --production",
    "test": "bun test ./tests && bun run test:rules",
    "test:rules": "node --test 'oxlint/rules/*.test.ts'",
    "test:coverage": "bun test ./tests --coverage --reporter=junit --reporter-outfile=./junit.xml",
    "test:watch": "bun test ./tests --watch",
    "prepare": "effect-tsgo patch --no-typescript --oxlint",
    "postinstall": "bun2nix -o bun.nix"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.5",
    "effect": "4.0.5"
  },
  "devDependencies": {
    "@effect/tsgo": "0.54.1",
    "@oxlint/plugins": "1.89.0",
    "@testcontainers/postgresql": "12.2.1",
    "@types/bun": "1.4.3",
    "bun2nix": "2.1.2",
    "knip": "6.42.1",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.5"
  },
  "packageManager": "bun@1.4.3"
}
