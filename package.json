{
  "name": "autoscan",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "oxlint --type-aware --fix && effect-language-service diagnostics --project tsconfig.json",
    "format": "oxfmt",
    "typecheck": "tsgo --noEmit",
    "dev": "NODE_ENV=development bun --watch src/index.ts",
    "build": "bun build ./src/index.ts --outfile ./index --compile",
    "test": "bun --bun vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "knip": "knip"
  },
  "dependencies": {
    "@effect/platform": "^0.94.5",
    "@effect/platform-bun": "^0.87.1",
    "@grammyjs/conversations": "^2.1.1",
    "@grammyjs/hydrate": "^1.6.0",
    "drizzle-orm": "^1.0.0-beta.9-e89174b",
    "effect": "^3.19.18",
    "grammy": "^1.40.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.2",
    "@commitlint/config-conventional": "^20.4.2",
    "@effect/language-service": "^0.74.0",
    "@effect/vitest": "^0.27.0",
    "@tsconfig/bun": "^1.0.10",
    "@types/bun": "^1.3.9",
    "@types/node": "^25.3.0",
    "@typescript/native-preview": "^7.0.0-dev.20260219.1",
    "@vitest/coverage-istanbul": "4.0.18",
    "drizzle-kit": "^1.0.0-beta.9-e89174b",
    "knip": "^5.84.1",
    "lefthook": "^2.1.1",
    "oxfmt": "^0.33.0",
    "oxlint": "^1.48.0",
    "oxlint-tsgolint": "^0.14.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  }
}
