{
  "name": "autoscan",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "imports": {
    "#*": "./src/*.js"
  },
  "scripts": {
    "check": "vp check --fix",
    "lint": "vp lint --fix --fix-suggestions",
    "dev": "tsx --env-file=.env --watch src/index.ts",
    "pack": "vp pack",
    "db:generate": "drizzle-kit generate",
    "knip": "knip",
    "test": "vp test run",
    "test:coverage": "vp test run --coverage",
    "test:watch": "vp test"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.4.4",
    "croner": "^10.0.1",
    "drizzle-orm": "^1.0.0-beta.22-41a7d21",
    "fastify": "^5.8.4",
    "pg": "^8.20.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "^4.1.4",
    "drizzle-kit": "^1.0.0-beta.22-41a7d21",
    "knip": "^6.3.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vite-plus": "latest"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "overrides": {
      "vite": "npm:@voidzero-dev/vite-plus-core@latest",
      "vitest": "npm:@voidzero-dev/vite-plus-test@latest"
    }
  }
}
