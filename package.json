{
  "name": "autoscan",
  "private": true,
  "scripts": {
    "lint": "oxlint --fix",
    "format": "oxfmt",
    "typecheck": "tsgo --noEmit",
    "dev": "NODE_ENV=development bun --watch src/index.ts",
    "build": "bun build ./src/index.ts --outfile ./index --compile"
  },
  "type": "module",
  "dependencies": {
    "@grammyjs/conversations": "^2.1.1",
    "@grammyjs/hydrate": "^1.6.0",
    "arkenv": "^0.8.0",
    "arktype": "^2.1.28",
    "croner": "^9.1.0",
    "drizzle-orm": "^0.45.0",
    "grammy": "^1.38.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "@tsconfig/bun": "^1.0.10",
    "@types/bun": "^1.3.3",
    "@typescript/native-preview": "^7.0.0-dev.20251207.1",
    "drizzle-kit": "^0.31.8",
    "eslint-plugin-perfectionist": "^5.0.0",
    "lefthook": "^2.0.8",
    "oxfmt": "^0.22.0",
    "oxlint": "^1.31.0",
    "oxlint-tsgolint": "^0.10.0"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  }
}
