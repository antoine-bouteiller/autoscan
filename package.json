{
  "name": "autoscan",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*.js"
  },
  "scripts": {
    "check": "vp check --fix",
    "lint": "vp lint --fix --fix-suggestions",
    "dev": "tsx --env-file=.env --watch src/index.ts",
    "pack": "vp pack",
    "db:generate": "drizzle-kit generate",
    "knip": "knip",
    "test": "vp test run",
    "test:coverage": "vp test run --coverage",
    "test:watch": "vp test"
  },
  "dependencies": {
    "croner": "10.0.1",
    "drizzle-orm": "1.0.0-beta.22-41a7d21",
    "postgres": "3.4.9",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "21.0.2",
    "@commitlint/config-conventional": "21.0.2",
    "@electric-sql/pglite": "0.5.2",
    "@types/node": "25.9.1",
    "@vitest/coverage-v8": "4.1.8",
    "drizzle-kit": "1.0.0-beta.22-41a7d21",
    "knip": "6.16.1",
    "lefthook": "2.1.9",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "vite-plus": "0.1.24"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "packageManager": "pnpm@11.6.0"
}
