{
  "name": "autoscan",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "vp lint --type-aware --fix",
    "format": "vp fmt",
    "typecheck": "tsgo --noEmit",
    "dev": "vp dev",
    "db:generate": "drizzle-kit generate && tsx ./scripts/bundle_migrations.ts",
    "knip": "knip",
    "test": "vp test run",
    "test:coverage": "vp test run --coverage",
    "test:watch": "vp test"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "croner": "^10.0.1",
    "drizzle-orm": "^1.0.0-beta.9-e89174b",
    "fastify": "^5.8.2",
    "valibot": "^1.2.0"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^25.5.0",
    "@typescript/native-preview": "^7.0.0-dev.20260314.1",
    "@vitest/coverage-v8": "^4.1.0",
    "drizzle-kit": "^1.0.0-beta.9-e89174b",
    "knip": "^5.86.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vite-plus": "latest",
    "vitest": "npm:@voidzero-dev/vite-plus-test@latest"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "overrides": {
      "vite": "npm:@voidzero-dev/vite-plus-core@latest",
      "vitest": "npm:@voidzero-dev/vite-plus-test@latest"
    }
  }
}
