{
  "name": "autoscan",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "oxlint --type-aware --fix",
    "format": "oxfmt",
    "typecheck": "tsgo --noEmit",
    "dev": "NODE_ENV=development tsx --watch src/index.ts",
    "db:generate": "drizzle-kit generate && tsx ./scripts/bundle_migrations.ts",
    "build": "tsdown",
    "knip": "knip",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "croner": "^10.0.1",
    "drizzle-orm": "^1.0.0-beta.9-e89174b",
    "fastify": "^5.8.2",
    "valibot": "^1.2.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.4",
    "@commitlint/config-conventional": "^20.4.4",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^25.5.0",
    "@typescript/native-preview": "^7.0.0-dev.20260314.1",
    "@vitest/coverage-istanbul": "^4.1.0",
    "drizzle-kit": "^1.0.0-beta.9-e89174b",
    "knip": "^5.86.0",
    "lefthook": "^2.1.4",
    "oxfmt": "^0.40.0",
    "oxlint": "^1.55.0",
    "oxlint-tsgolint": "^0.16.0",
    "semantic-release": "^25.0.3",
    "tsdown": "^0.21.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  }
}
