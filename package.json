{
  "name": "autoscan",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "fmt": "oxfmt -c oxfmt.config.ts",
    "lint": "oxlint -c oxlint.config.ts --type-aware --type-check --fix --fix-suggestions",
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "db:generate": "drizzle-kit generate",
    "knip": "knip",
    "test": "bun test ./tests",
    "test:coverage": "bun test ./tests --coverage --reporter=junit --reporter-outfile=./junit.xml",
    "test:watch": "bun test ./tests --watch",
    "postinstall": "bun2nix -o bun.nix"
  },
  "dependencies": {
    "drizzle-orm": "1.0.0-rc.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@testcontainers/postgresql": "12.0.4",
    "@types/bun": "1.3.14",
    "bun2nix": "2.1.1",
    "drizzle-kit": "1.0.0-rc.4",
    "knip": "6.27.0",
    "lefthook": "2.1.10",
    "oxfmt": "0.59.0",
    "oxlint": "1.74.0",
    "oxlint-tsgolint": "0.25.0",
    "typescript": "7.0.2"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "packageManager": "bun@1.3.14",
  "trustedDependencies": [
    "lefthook"
  ]
}
