{
  "name": "autoscan",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "fmt": "oxfmt",
    "lint": "oxlint --fix --fix-suggestions",
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "db:generate": "drizzle-kit generate",
    "knip": "knip",
    "test": "bun test ./tests && bun run test:rules",
    "test:rules": "node --test 'oxlint/rules/*.test.ts'",
    "test:coverage": "bun test ./tests --coverage --reporter=junit --reporter-outfile=./junit.xml",
    "test:watch": "bun test ./tests --watch",
    "prepare": "effect-tsgo patch --no-typescript --oxlint",
    "postinstall": "bun2nix -o bun.nix"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.0-rc.111",
    "drizzle-orm": "1.0.0-rc.4",
    "effect": "4.0.0-rc.111"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@effect/tsgo": "0.36.5",
    "@oxlint/plugins": "^1.78.0",
    "@testcontainers/postgresql": "12.1.0",
    "@types/bun": "1.4.0",
    "bun2nix": "2.1.2",
    "drizzle-kit": "1.0.0-rc.4",
    "knip": "6.32.2",
    "lefthook": "2.1.10",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.0-rc.111"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "packageManager": "bun@1.3.14",
  "trustedDependencies": [
    "lefthook"
  ]
}
