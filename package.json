{
  "name": "autoscan",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "fmt": "oxfmt",
    "lint": "oxlint --fix --fix-suggestions --max-warnings=0",
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "db:generate": "drizzle-kit generate",
    "knip": "knip",
    "knip:production": "knip --production",
    "test": "bun test ./tests && bun run test:rules",
    "test:rules": "node --test 'oxlint/rules/*.test.ts'",
    "test:coverage": "bun test ./tests --coverage --reporter=junit --reporter-outfile=./junit.xml",
    "test:watch": "bun test ./tests --watch",
    "prepare": "effect-tsgo patch --no-typescript --oxlint",
    "postinstall": "bun2nix -o bun.nix"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.0",
    "drizzle-orm": "1.0.0-rc.4",
    "effect": "4.0.1"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@effect/tsgo": "0.48.1",
    "@oxlint/plugins": "1.86.0",
    "@testcontainers/postgresql": "12.2.0",
    "@types/bun": "1.4.2",
    "bun2nix": "2.1.2",
    "drizzle-kit": "1.0.0-rc.4",
    "knip": "6.39.0",
    "lefthook": "2.1.16",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.1"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "packageManager": "bun@1.4.2",
  "trustedDependencies": [
    "lefthook"
  ]
}
