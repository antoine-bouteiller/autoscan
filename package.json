{
  "name": "autoscan",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "oxlint --type-aware --fix",
    "format": "oxfmt",
    "typecheck": "tsgo --noEmit",
    "dev": "NODE_ENV=development bun --watch src/index.ts",
    "build": "bun build ./src/index.ts --outfile ./index --compile"
  },
  "dependencies": {
    "@grammyjs/conversations": "^2.1.1",
    "@grammyjs/hydrate": "^1.6.0",
    "arkenv": "^0.8.3",
    "arktype": "^2.1.29",
    "croner": "^9.1.0",
    "drizzle-orm": "^0.45.1",
    "grammy": "^1.39.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.3.0",
    "@commitlint/config-conventional": "^20.3.0",
    "@tsconfig/bun": "^1.0.10",
    "@types/bun": "^1.3.5",
    "@typescript/native-preview": "^7.0.0-dev.20260107.1",
    "drizzle-kit": "^0.31.8",
    "eslint-plugin-perfectionist": "^5.3.0",
    "lefthook": "^2.0.13",
    "oxfmt": "^0.23.0",
    "oxlint": "^1.38.0",
    "oxlint-tsgolint": "^0.11.0"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  }
}
