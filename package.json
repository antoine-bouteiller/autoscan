{
  "name": "autoscan",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*.js"
  },
  "scripts": {
    "check": "vp check --fix",
    "lint": "vp lint --fix --fix-suggestions",
    "dev": "tsx --env-file=.env --watch src/index.ts",
    "pack": "vp pack",
    "db:generate": "drizzle-kit generate",
    "knip": "knip",
    "test": "vp test run",
    "test:coverage": "vp test run --coverage",
    "test:watch": "vp test"
  },
  "dependencies": {
    "croner": "10.0.1",
    "drizzle-orm": "1.0.0-beta.22-41a7d21",
    "postgres": "3.4.9",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.4.5",
    "@types/node": "25.9.1",
    "@vitest/coverage-v8": "4.1.6",
    "drizzle-kit": "1.0.0-beta.22-41a7d21",
    "knip": "6.14.1",
    "tsx": "4.22.3",
    "typescript": "6.0.3",
    "vite-plus": "0.1.21"
  },
  "packageManager": "pnpm@11.2.1",
  "pnpm": {
    "overrides": {
      "vite": "npm:@voidzero-dev/vite-plus-core@latest",
      "vitest": "npm:@voidzero-dev/vite-plus-test@latest"
    }
  }
}
