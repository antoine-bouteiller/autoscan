{
  "name": "autoscan",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "lint": "oxlint --fix --fix-suggestions --max-warnings=0",
    "dev": "bun --watch src/index.ts",
    "knip": "devkit knip",
    "knip:production": "devkit knip --production",
    "test": "bun test ./tests",
    "test:coverage": "bun test ./tests --coverage --reporter=junit --reporter-outfile=./junit.xml",
    "test:watch": "bun test ./tests --watch",
    "prepare": "effect-tsgo patch --no-typescript --oxlint",
    "postinstall": "bun scripts/nix_deps.ts"
  },
  "dependencies": {
    "@effect/platform-bun": "4.1.6",
    "effect": "4.1.6",
    "onnxruntime-web": "1.31.1"
  },
  "devDependencies": {
    "@antoine-bouteiller/devkit": "0.5.0",
    "@effect/tsgo": "0.73.7",
    "@types/bun": "1.4.5"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.1.6"
  },
  "packageManager": "bun@1.4.5"
}
