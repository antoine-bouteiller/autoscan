{
  "name": "autoscan",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "lint": "oxlint --fix --fix-suggestions --max-warnings=0",
    "dev": "bun --watch src/index.ts",
    "knip": "knip",
    "knip:production": "knip --production",
    "test": "bun test ./tests && bun run test:rules",
    "test:rules": "node --test 'oxlint/rules/*.test.ts'",
    "test:coverage": "bun test ./tests --coverage --reporter=junit --reporter-outfile=./junit.xml",
    "test:watch": "bun test ./tests --watch",
    "prepare": "effect-tsgo patch --no-typescript --oxlint",
    "postinstall": "bun scripts/nix_deps.ts"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.6",
    "effect": "4.0.6"
  },
  "devDependencies": {
    "@effect/tsgo": "0.62.0",
    "@oxlint/plugins": "1.90.0",
    "@types/bun": "1.4.4",
    "knip": "6.43.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.6"
  },
  "packageManager": "bun@1.4.4"
}
