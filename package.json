{
  "name": "autoscan",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*.js"
  },
  "scripts": {
    "check": "vp check --fix",
    "lint": "vp lint --fix --fix-suggestions",
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "pack": "vp pack",
    "db:generate": "drizzle-kit generate",
    "knip": "knip",
    "test": "vp test run",
    "test:coverage": "vp test run --coverage",
    "test:watch": "vp test",
    "postinstall": "bun2nix -o bun.nix"
  },
  "dependencies": {
    "drizzle-orm": "1.0.0-beta.22-41a7d21",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "21.1.0",
    "@commitlint/config-conventional": "21.1.0",
    "@electric-sql/pglite": "0.5.3",
    "@types/bun": "1.3.14",
    "bun2nix": "2.1.0",
    "drizzle-kit": "1.0.0-beta.22-41a7d21",
    "knip": "6.22.0",
    "lefthook": "2.1.9",
    "typescript": "6.0.3",
    "vite-plus": "0.2.1"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@latest"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "packageManager": "bun@1.3.14",
  "trustedDependencies": [
    "lefthook"
  ]
}
