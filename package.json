{
  "name": "autoscan",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "oxlint --type-aware --fix",
    "format": "oxfmt",
    "typecheck": "tsgo --noEmit",
    "dev": "NODE_ENV=development bun --watch src/index.ts",
    "build": "bun build ./src/index.ts --outfile ./index --compile",
    "knip": "knip"
  },
  "dependencies": {
    "@grammyjs/conversations": "^2.1.1",
    "@grammyjs/hydrate": "^1.6.0",
    "arktype": "^2.1.29",
    "croner": "^10.0.0",
    "drizzle-orm": "^1.0.0-beta.12-a5629fb",
    "grammy": "^1.39.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.3.1",
    "@commitlint/config-conventional": "^20.3.1",
    "@tsconfig/bun": "^1.0.10",
    "@types/bun": "^1.3.6",
    "@types/node": "^25.2.2",
    "@typescript/native-preview": "^7.0.0-dev.20260122.4",
    "drizzle-kit": "^1.0.0-beta.12-a5629fb",
    "knip": "^5.83.1",
    "lefthook": "^2.0.15",
    "oxfmt": "^0.31.0",
    "oxlint": "^1.41.0",
    "oxlint-tsgolint": "^0.11.1",
    "typescript": "^5.9.3"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  }
}
